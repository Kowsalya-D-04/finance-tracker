# Copy this file to .env and change the values.
SECRET_KEY=change-this-secret-key
JWT_SECRET_KEY=change-this-jwt-secret-key

# SQLite (default, no setup needed). The file is created in backend/instance/
DATABASE_URL=sqlite:///finance_tracker.db

# MySQL 8.x (for deployment) - install PyMySQL first, create the database, then use:
# DATABASE_URL=mysql+pymysql://finance_user:strong_password@localhost:3306/finance_tracker?charset=utf8mb4

# Comma-separated list of frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Access-token lifetime in hours
JWT_EXPIRES_HOURS=24
